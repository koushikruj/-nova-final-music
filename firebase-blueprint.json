{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and subscription metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isSubscribed": { "type": "boolean" },
        "subscriptionPlan": { "type": "string" },
        "subscribedAt": { "type": "string" },
        "subscriptionExpiresAt": { "type": "string" },
        "status": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "permissions": { "type": "object" },
        "lastIpAddress": { "type": "string" },
        "hardwareId": { "type": "string" },
        "ipHistory": { "type": "array" },
        "lastLoginAt": { "type": "string" },
        "isBanned": { "type": "boolean" },
        "bannedIp": { "type": "boolean" },
        "bannedHwid": { "type": "boolean" },
        "banReason": { "type": "string" }
      },
      "required": ["uid"]
    },
    "SubscriptionRequest": {
      "title": "SubscriptionRequest",
      "description": "Subscription upgrade requests submitted by users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "planName": { "type": "string" },
        "amount": { "type": "string" },
        "durationDays": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "planName", "status", "createdAt"]
    },
    "UserFavorite": {
      "title": "UserFavorite",
      "description": "A track favorited by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "trackId": { "type": "string", "maxLength": 128 },
        "addedAt": { "type": "string" }
      },
      "required": ["id", "trackId", "addedAt"]
    },
    "UserPlaylist": {
      "title": "UserPlaylist",
      "description": "A playlist created or imported by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "coverImage": { "type": "string", "maxLength": 1000 },
        "trackIds": { "type": "array", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "trackIds", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection"
    },
    "/users/{userId}/favorites/{favoriteId}": {
      "schema": "UserFavorite",
      "description": "User favorites subcollection"
    },
    "/users/{userId}/playlists/{playlistId}": {
      "schema": "UserPlaylist",
      "description": "User playlists subcollection"
    },
    "/subscription_requests/{requestId}": {
      "schema": "SubscriptionRequest",
      "description": "Subscription upgrade requests collection"
    }
  }
}
